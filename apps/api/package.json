    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "resend": "^4.0.0",
    "cloudinary": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
