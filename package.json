{
  "name": "eventflow",
  "private": true,
  "version": "1.0.0",
  "description": "EventFlow monorepo — web/mobile event management platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @eventflow/api dev",
    "dev:web-admin": "pnpm --filter @eventflow/web-admin dev",
    "dev:web-attendee": "pnpm --filter @eventflow/web-attendee dev",
    "dev:sao": "pnpm --filter @eventflow/sao-engine dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "db:generate": "pnpm --filter @eventflow/api db:generate",
    "db:migrate": "pnpm --filter @eventflow/api db:migrate",
    "db:studio": "pnpm --filter @eventflow/api db:studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.x",
    "@typescript-eslint/parser": "^7.x",
    "eslint": "^8.x",
    "prettier": "^3.x",
    "husky": "^9.x",
    "lint-staged": "^15.x",
    "typescript": "^5.x"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{js,json,md}": ["prettier --write"]
  }
}
