# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://eventflow:eventflow_dev@localhost:5432/eventflow"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth Secrets (min 32 chars each, all different) ───────────────────────────
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars_here"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars_here"
HMAC_SECRET="change_me_hmac_secret_min_32_chars_here"

# ── External Services ─────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# ── Microservice ──────────────────────────────────────────────────────────────
SAO_ENGINE_URL="http://localhost:8000"

# ── CORS Origins ──────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5174"
ADMIN_URL="http://localhost:5173"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
